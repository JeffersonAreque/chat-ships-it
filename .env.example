# Local web server
PORT=3000

# Use dev for local fake chat, or twitch to read a Twitch channel
CHAT_MODE=dev
TWITCH_CHANNEL=your_channel_name

# Optional authenticated Twitch IRC settings. Leave blank for anonymous read-only chat.
TWITCH_CHAT_NICK=
TWITCH_CHAT_TOKEN=

# Extra blocked words, separated by commas
BANNED_WORDS=

# Change this before opening the admin panel
ADMIN_PASSWORD=replace_with_a_private_password

# mock avoids Codex usage; real runs the Codex CLI after streamer approval
CODEX_MODE=mock
# Optional executable path; blank uses `codex` from PATH
CODEX_CLI=
